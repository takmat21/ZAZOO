# Amazon Advertising API 認証情報（このファイルをコピーして .env を作成）
# .env は .gitignore 済み。実際の値は絶対にコミットしないこと。

# Login with Amazon (LWA) アプリの資格情報
ADS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxx
ADS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 広告 API のリフレッシュトークン（OAuth 認可フローで取得）
ADS_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxxxxxxxxxx

# 対象プロファイル ID（出品アカウント × マーケットプレイス）
ADS_PROFILE_ID=1234567890

# リージョン: NA / EU / FE（日本は FE）
ADS_REGION=FE
